# Copy this file to .env and replace the placeholder values with your own.
# .env is listed in .gitignore, so it is never committed.

# Your OpenAI API key, from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# A chat model that supports tool calling.
# gpt-5-nano is the cheapest; gpt-5-mini is more reliable at calling tools.
OPENAI_MODEL=your-model-name
