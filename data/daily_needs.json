  "intake_notes": {
    "vitamin_e": "The UK has no official daily target (RNI) for vitamin E. The adult figures are NHS guide amounts. There's no UK figure for children and teenagers.",
    "vitamin_k": "Adults need about 1µg of vitamin K a day for each kg of body weight. The figure shown assumes a body weight of 65kg, the NHS example. There's no UK figure for children and teenagers."
  },
  "pregnancy": {
    "extra": {
      "vitamin_a": 100,
      "vitamin_b1": 0.1,
      "vitamin_b2": 0.3,
      "vitamin_b9": 100,
      "vitamin_c": 10
    },
    "extra_notes": {
      "vitamin_b1": "The extra thiamin is for the last 3 months of pregnancy only.",
      "vitamin_c": "The extra vitamin C is for the last 3 months of pregnancy only.",
      "vitamin_b9": "This is from food. The NHS also advises a 400µg folic acid supplement until 12 weeks."
    },
    "notes": [
      "Take a 400µg folic acid supplement every day while trying for a baby and until you're 12 weeks pregnant. Some women are prescribed a higher 5mg dose by a GP.",
      "Take a 10µg vitamin D supplement every day between early October and late March.",
      "Don't take cod liver oil or supplements containing vitamin A (retinol), and avoid liver and liver products. Too much vitamin A can harm a baby's development.",
      "Iron levels are checked at the booking appointment and at around 28 weeks. A GP or midwife will advise if iron supplements are needed.",
      "You may be able to get free vitamins through Healthy Start.",
      "A midwife or GP can give advice specific to your pregnancy."
    ]
  },
  "upper_limits": {
    "vitamin_a": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 1500,
        "applies_to": "food and supplements combined",
        "note": "Too much vitamin A over many years may weaken bones. If you eat liver every week, don't take supplements containing vitamin A. If pregnant, avoid vitamin A supplements and liver completely."
      }
    ],
    "vitamin_b1": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 100,
        "applies_to": "supplements",
        "note": "There isn't enough evidence to know the effects of taking higher doses every day."
      }
    ],
    "vitamin_b2": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 40,
        "applies_to": "supplements",
        "note": "There isn't enough evidence to know the effects of taking higher doses every day."
      }
    ],
    "vitamin_b3": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 17,
        "applies_to": "nicotinic acid supplements",
        "note": "For nicotinamide supplements the NHS figure is 500mg or less a day. High doses of nicotinic acid can cause skin flushing, and over a long time could damage the liver."
      }
    ],
    "vitamin_b6": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 10,
        "applies_to": "supplements",
        "note": "Don't take more unless a doctor advises it. 200mg or more a day can cause loss of feeling in the arms and legs."
      }
    ],
    "vitamin_b9": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 1000,
        "applies_to": "folic acid supplements",
        "note": "Doses above 1mg can hide the signs of vitamin B12 deficiency. Some women are prescribed 5mg before and in early pregnancy; follow the doctor's advice."
      }
    ],
    "vitamin_b12": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 2000,
        "applies_to": "supplements",
        "note": "This is 2mg. There isn't enough evidence to know the effects of taking higher doses every day."
      }
    ],
    "vitamin_c": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 1000,
        "applies_to": "supplements",
        "note": "The NHS says less than 1,000mg a day is unlikely to cause harm. More can cause stomach pain, diarrhoea and wind."
      }
    ],
    "vitamin_d": [
      {
        "age_min": 1,
        "age_max": 10,
        "amount": 50,
        "applies_to": "supplements",
        "note": "50µg is 2,000 IU. Follow a doctor's advice if they recommend a different amount."
      },
      {
        "age_min": 11,
        "age_max": null,
        "amount": 100,
        "applies_to": "supplements",
        "note": "100µg is 4,000 IU. This includes pregnant and breastfeeding women and older people. Some medical conditions mean people can't safely take as much; follow a doctor's advice."
      }
    ],
    "vitamin_e": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 540,
        "applies_to": "supplements",
        "note": "540mg is 800 IU. There isn't enough evidence to know the effects of taking higher doses every day."
      }
    ],
    "vitamin_k": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 1000,
        "applies_to": "supplements",
        "note": "This is 1mg. Don't take vitamin K supplements if you take warfarin."
      }
    ],
    "iron": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 17,
        "applies_to": "supplements",
        "note": "Keep taking a higher dose if a GP has advised it. Doses over 20mg can cause constipation, feeling sick and stomach pain. Keep iron supplements out of children's reach: an overdose can be fatal."
      }
    ],
    "calcium": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 1500,
        "applies_to": "supplements",
        "note": "More than this could cause stomach pain and diarrhoea."
      }
    ],
    "magnesium": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 400,
        "applies_to": "supplements",
        "note": "More than this for a short time can cause diarrhoea."
      }
    ],
    "zinc": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 25,
        "applies_to": "supplements",
        "note": "Don't take more unless a doctor advises it. High doses reduce copper absorption, which can lead to anaemia and weaker bones."
      }
    ],
    "potassium": [
      {
        "age_min": 19,
        "age_max": null,
        "amount": 3700,
        "applies_to": "supplements",
        "note": "Older people and anyone with kidney disease shouldn't take potassium supplements unless a doctor advises it."
      }
    ]
